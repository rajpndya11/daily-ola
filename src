.rail button b{font-size:12px;width:18px;font-variant-numeric:tabular-nums}
.rail button.on{color:var(--fg);font-weight:700}
.rail button.on b{background:var(--on);color:var(--onfg);border-radius:4px;padding:1px 0;text-align:center}
.note{font-size:14px;line-height:1.55;color:var(--mut);max-width:42ch;min-height:5.5em}
.note strong{color:var(--fg)}
.legend{font-size:12px;color:var(--mut);margin-top:22px;max-width:44ch;line-height:1.5}
.phone{width:380px;height:min(760px,calc(100svh - 56px));background:var(--p0);color:var(--pt);border-radius:40px;border:8px solid #1c1c1c;box-shadow:0 0 0 1px #333,0 24px 60px rgba(0,0,0,.35);overflow:hidden;position:sticky;top:20px;display:flex;flex-direction:column}
.sb{display:flex;justify-content:space-between;font-size:12px;font-weight:600;padding:12px 24px 0;color:var(--pt)}
.scr{display:none;flex-direction:column;flex:1;min-height:0;padding:18px 20px 20px;overflow-y:auto;gap:14px}
.scr.on{display:flex;animation:in .25s ease}
@keyframes in{from{opacity:0;transform:translateX(10px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.scr.on{animation:none}}
.logo{font-weight:800;letter-spacing:-.02em;font-size:15px;display:flex;align-items:center;gap:8px}
.logo i{width:10px;height:10px;border-radius:50%;background:var(--acc)}
h2{font-size:27px;font-weight:800;letter-spacing:-.03em;line-height:1.1}
.m{color:var(--pm);font-size:13px;line-height:1.45}
.card{background:var(--p1);border-radius:18px;padding:14px 16px}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px}
.lbl{font-size:12px;color:var(--pm);margin-bottom:3px}
.val{font-size:16px;font-weight:600}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{padding:9px 14px;border-radius:999px;background:var(--p2);font-size:14px;font-weight:600;color:var(--pm)}
.chip.on{background:var(--acc);color:#000}
.cta{margin-top:auto;background:var(--acc);color:#000;font-weight:700;font-size:16px;padding:16px;border-radius:16px;width:100%}
.ghost{background:var(--p2);color:var(--pt);font-weight:600;padding:14px;border-radius:16px;width:100%;font-size:15px}
.big{font-size:44px;font-weight:800;letter-spacing:-.04em;line-height:1}
.ok{color:var(--acc)}.bad{color:var(--warn)}
.ck{list-style:none;padding:0;display:flex;flex-direction:column;gap:9px;font-size:14px}
.ck li{display:flex;gap:10px}.ck li:before{content:"✓";color:var(--acc);font-weight:800}
.seg{display:flex;background:var(--p2);border-radius:12px;padding:3px}
.seg button{flex:1;padding:9px;border-radius:9px;font-size:14px;font-weight:600;color:var(--pm)}
.seg button.on{background:var(--pt);color:#000}
.bar{height:6px;background:var(--p2);border-radius:3px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--acc);border-radius:3px;transition:width .6s}
.bar.late i{background:var(--warn)}
.banner{border-radius:16px;padding:14px 16px;background:rgba(255,90,60,.14);border:1px solid var(--warn);display:none;flex-direction:column;gap:6px;font-size:14px}
.banner.on{display:flex}
.leg{display:flex;gap:14px;align-items:flex-start}
