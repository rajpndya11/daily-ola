body{background:var(--bg);color:var(--fg);font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;-webkit-font-smoothing:antialiased}
button{font:inherit;color:inherit;border:0;background:none;cursor:pointer}
button:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
.wrap{max-width:980px;margin:0 auto;padding:28px 20px 40px;display:grid;grid-template-columns:1fr 380px;gap:56px;align-items:start}
.side h1{font-size:34px;font-weight:800;letter-spacing:-.03em;line-height:1.05}
.side p.sub{color:var(--mut);margin:10px 0 28px;max-width:34ch;line-height:1.5}
.rail{display:flex;flex-direction:column;gap:2px;margin-bottom:26px}
