import {useStore} from './store'
import {NOTES} from './data'
import {Setup,Pass,Today,Trip,Transit,Month} from './screens'
const SCR=[Setup,Pass,Today,Trip,Transit,Month]
const toggleTheme=()=>{const d=document.documentElement,c=d.dataset.theme||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');d.dataset.theme=c==='dark'?'light':'dark'}
export default function App(){
  const [s,set,reset]=useStore(),go=i=>set({step:i}),Cur=SCR[s.step]
  return <>
    <div className="wrap">
      <div className="side">
        <h1>Ola Daily</h1>
        <p className="sub">Your commute, subscribed. Tap through the rider journey on the phone.</p>
        <nav className="rail">{NOTES.map((n,i)=><button key={n[0]} className={i===s.step?'on':''} onClick={()=>go(i)}><b>{i+1}</b>{n[0]}</button>)}</nav>
        <p className="note" dangerouslySetInnerHTML={{__html:NOTES[s.step][1]}}/>
        <p className="legend">Ola Electric APM assignment prototype. Places, price and ride data are examples only. Price uses the ₹5 per rider-km hypothesis.</p>
      </div>
      <div className="phone" role="application" aria-label="Ola Daily app">
        <div className="sb"><span>8:41</span><span>5G ▮▮▮</span></div>
        <section className="scr on" key={s.step}><Cur s={s} set={set} go={go} reset={reset}/></section>
      </div>
    </div>
    <button className="themebtn" onClick={toggleTheme}>Light / Dark</button>
  </>
}

export const DAYS=['Mon','Tue','Wed','Thu','Fri','Sat']
export const TIMES=['8:30','9:00','9:30']
export const dayCount=d=>Math.round(d.filter(Boolean).length*4.4)
export const fare=n=>5*12*2*n // Rs 5 per rider-km x 12 km (example) x 2 trips x days
export const tm=(t,d)=>{const [h,m]=t.split(':').map(Number),x=h*60+m+d;return Math.floor(x/60)+':'+String(x%60).padStart(2,'0')}
export const win=t=>tm(t,-8)+'–'+t
