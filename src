# Ola Daily
Flat project: every file sits at the top level, no folders.
Vercel: framework Vite, build `npm run build`, output `dist`.
Local: `npm install && npm run dev`

import {useEffect,useMemo} from 'react'
import {DAYS,TIMES,dayCount,fare,tm,win} from './data'
const Logo=({t})=><div className="logo"><i/>{t}</div>
const Sw=({on,onClick,children})=><label className={'sw'+(on?' on':'')} onClick={onClick}><span/>{children}</label>
const price=s=>fare(dayCount(s.days)).toLocaleString('en-IN')

export const Setup=({s,set,go})=><>
  <Logo t="Ola Daily"/><h2>Set up your commute once</h2>
  <p className="m">We plan the rest. You decide again only when your routine changes.</p>
  <div className="card"><div className="lbl">From</div><div className="val">Home · Indiranagar</div></div>
  <div className="card"><div className="lbl">To</div><div className="val">Office · Manyata Tech Park</div></div>
  <div><div className="lbl">Arrive by</div><div className="chips">{TIMES.map(t=><button key={t} className={'chip'+(s.arrive===t?' on':'')} onClick={()=>set({arrive:t})}>{t}</button>)}</div></div>
  <div><div className="lbl">Days</div><div className="chips">{DAYS.map((d,i)=><button key={d} className={'chip'+(s.days[i]?' on':'')} onClick={()=>set({days:s.days.map((v,j)=>j===i?1-v:v)})}>{d}</button>)}</div></div>
  <button className="cta" disabled={!s.days.some(Boolean)} onClick={()=>go(1)}>See my Daily Pass</button>
</>

export const Pass=({s,set,go})=><>
  <Logo t="Ola Daily"/><h2>One price. Every leg.</h2>
  <div className="card"><div className="lbl">Daily Pass</div><div className="big">₹{price(s)}<span className="m"> /month</span></div>
    <p className="m" style={{marginTop:8}}>Example: ₹5 × 12 km × 2 trips × {dayCount(s.days)} days</p></div>
  <ul className="ck"><li>Seat reserved on every ride</li><li>Link, metro and bus on one QR</li><li>Backup ride if your window is at risk</li><li>Fare credit on next month if we miss it</li></ul>
  <div><div className="lbl">Who pays</div><div className="seg">{['Me','My employer'].map((p,i)=><button key={p} className={s.payer===i?'on':''} onClick={()=>set({payer:i})}>{p}</button>)}</div></div>
  <div className="card"><div className="val">Commute group</div><div className="m">Indiranagar → Manyata · {win(s.arrive)}<br/>5 co-riders · 1 seat left</div></div>
  <button className="cta" onClick={()=>{set({subscribed:true,mins:4});go(2)}}>{s.subscribed?'Open today':'Join group and subscribe'}</button>
</>

export function Today({s,set}){
  useEffect(()=>{const t=setInterval(()=>set(o=>o.mins>0?{mins:o.mins-1}:{}),4000);return()=>clearInterval(t)},[])
  return <>
    <div className="row"><Logo t="Today"/><span className="m">{s.leave?'Pass paused':'Mon · to office'}</span></div>
    <div><div className="lbl">{s.mins?'Your Link arrives in':'Your Link is'}</div><div className="big ok">{s.mins?s.mins+' min':'here'}</div></div>
    <svg viewBox="0 0 340 130" style={{width:'100%',borderRadius:18,background:'#141414'}} aria-label="Route map">
      <path d="M0 90H340M60 0V130M200 0V130M0 30L340 60" stroke="#262626" strokeWidth="6" fill="none"/>
      <path d="M60 100L60 60 130 60" stroke="#8f8f8f" strokeWidth="2" strokeDasharray="2 5" fill="none"/>
      <path d="M290 30L200 50 130 60" stroke="#d4f000" strokeWidth="3" fill="none"/>
      <circle cx="60" cy="100" r="6" fill="#fff"/><circle cx="130" cy="60" r="8" fill="#000" stroke="#d4f000" strokeWidth="3"/>
      <rect x={282-(4-s.mins)*18} y="22" width="18" height="14" rx="4" fill="#d4f000"/></svg>
    <div className="card row"><div><div className="val">Stop B · 3 min walk</div><div className="m">Seat 4 reserved · 5 co-riders</div></div><span className="ok">●</span></div>
    <div className="card"><div className="lbl">Reach Manyata Tech Park</div><div className="val">{win(s.arrive)}</div></div>
    <button className="cta" onClick={()=>set({step:3,prog:0,traffic:false,tripCredited:false})}>Tap to board</button>
    <button className="ghost" onClick={()=>set({paused:!s.paused})}>{s.paused?'Paused tomorrow · tap to undo':'Skip / pause tomorrow'}</button>
  </>
}

export function Trip({s,set,go}){
  useEffect(()=>{const t=setInterval(()=>set(o=>o.prog<100?{prog:Math.min(100,o.prog+(o.traffic?1:5))}:{}),1000);return()=>clearInterval(t)},[])
  const late=s.traffic,end=s.prog>=100
  const toggle=()=>set(o=>o.traffic?{traffic:false}:{traffic:true,tripCredited:true,credits:o.tripCredited?o.credits:o.credits+1})
  return <>
    <div className="row"><Logo t="On the way"/><span className="m">Seat 4</span></div>
    <div><div className="lbl">{end?'Arrived':'Arriving'}</div><div className={'big '+(late?'bad':'ok')}>{tm(s.arrive,late?14:-4)}</div>
      <p className="m">{late?(end?'Outside your window · credit applied':'Outside your window, so a backup ride is on its way'):(end?'You arrived inside your window':'Inside your '+win(s.arrive)+' window')}</p></div>
    <div className={'bar'+(late?' late':'')}><i style={{width:s.prog+'%'}}/></div>
    <div className={'banner'+(late?' on':'')}><b className="bad">Running late? Window at risk &gt;10 min</b><span>Backup ride dispatched automatically. It reaches you at the next stop.</span><span className="ok">Fare credit added to next month</span></div>
    <div className="card"><div className="lbl">Guarantee</div><div className="val">Reach by {s.arrive} or we make it right</div><p className="m" style={{marginTop:4}}>Backup ride, then auto-credit. No claim form.</p></div>
    <Sw on={late} onClick={toggle}>Prototype: simulate heavy traffic</Sw>
    <button className="cta" onClick={()=>go(4)}>Next: a metro commute</button>
  </>
}

export function Transit({go}){
  const cells=useMemo(()=>{let sd=7;const r=()=>(sd=(sd*9301+49297)%233280)/233280,o=[]
    for(let y=0;y<13;y++)for(let x=0;x<13;x++){const f=(x<5||x>7)&&(y<5||y>7)&&!(x>7&&y>7)
      if(f){const dx=x<5?x:x-8,dy=y<5?y:y-8,d=Math.max(Math.abs(dx-2),Math.abs(dy-2));o.push(d!==1)}else o.push(r()>.5)}
    return o},[])
  return <>
    <Logo t="Link → Metro → Link"/><h2>One QR. Tap in.</h2>
    <div className="qr" aria-label="Sample QR code">{cells.map((k,i)=><s key={i} className={k?'k':''}/>)}</div>
    <div style={{display:'flex',flexDirection:'column',gap:16,marginTop:6}}>
      {[['Link to metro station','6 min · seat reserved',''],['Metro','Included in your pass','o'],['Link to office gate','Waiting when you exit','']].map(([a,b,c])=>
        <div className="leg" key={a}><span className={'dot '+c}/><div><div className="val">{a}</div><div className="m">{b}</div></div></div>)}
    </div>
    <button className="cta" onClick={()=>go(5)}>View my month</button>
  </>
}

export const Month=({s,set,reset})=><>
  <Logo t="This month"/>
  <div className="card"><div className="lbl">On-time commutes (sample)</div><div className="big"><span className="ok">21</span><span className="m"> of 22</span></div><div className="bar" style={{marginTop:12}}><i style={{width:'95%'}}/></div></div>
  <div className="card"><div className="val">{s.credits} fare credit{s.credits>1?'s':''}</div><div className="m">Applied to next month automatically</div></div>
  <div className="card row"><div><div className="val">Daily Pass</div><div className="m">Renews on the 1st · paid by {s.payer?'your employer':'you'}</div></div><span className="val">₹{price(s)}</span></div>
  <Sw on={s.leave} onClick={()=>set({leave:!s.leave})}>Pause the pass for a week of leave</Sw>
  <p className="m">Pausing a day or a week never loses your seat in the commute group.</p>
  <button className="cta" onClick={reset}>Restart prototype</button>
</>

import {useState,useEffect} from 'react'
const K='ola-daily-v1'
export const init={step:0,arrive:'9:00',days:[1,1,1,1,1,0],payer:0,subscribed:false,paused:false,leave:false,traffic:false,tripCredited:false,credits:1,mins:4,prog:0}
const load=()=>{try{return {...init,...JSON.parse(localStorage.getItem(K))}}catch{return init}}
export function useStore(){
  const [s,S]=useState(load)
  useEffect(()=>{try{localStorage.setItem(K,JSON.stringify(s))}catch{}},[s])
  const set=p=>S(o=>({...o,...(typeof p==='function'?p(o):p)}))
  return [s,set,()=>S(init)]
}


:root{--bg:#f1f1f1;--fg:#000;--mut:#5f5f5f;--line:#d6d6d6;--on:#000;--onfg:#fff;
