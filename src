.qr{background:#fff;padding:10px;border-radius:14px;width:140px;height:140px;display:grid;grid-template-columns:repeat(13,1fr);gap:0;margin:0 auto}
.qr s{background:#fff}.qr s.k{background:#000}
.sw{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--pm);cursor:pointer}
