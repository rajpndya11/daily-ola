export const DAYS=['Mon','Tue','Wed','Thu','Fri','Sat']
export const TIMES=['8:30','9:00','9:30']
export const dayCount=d=>Math.round(d.filter(Boolean).length*4.4)
export const fare=n=>5*12*2*n // Rs 5 per rider-km x 12 km (example) x 2 trips x days
export const tm=(t,d)=>{const [h,m]=t.split(':').map(Number),x=h*60+m+d;return Math.floor(x/60)+':'+String(x%60).padStart(2,'0')}
export const win=t=>tm(t,-8)+'–'+t
export const NOTES=[
['Set up once','<strong>Decide once.</strong> Home, office and arrive-by time replace the daily "find a ride" ritual. No map search, no destination typing.'],
['Pick your pass','<strong>The commute is a contract.</strong> One monthly price, payable by rider or employer. Employer staff-transport spend is the first to convert.'],
['Morning','<strong>Zero decisions.</strong> The home screen answers one question: when does my Link arrive. Pausing is one tap, so people stay subscribed.'],
['The guarantee','<strong>A window, not a promise of exact minutes.</strong> If it is at risk, a backup ride and an automatic credit happen without a claim. Try the traffic switch.'],
['One QR, every leg','<strong>Transit is a partner, not a rival.</strong> Link fills the first and last mile, and one QR covers Link, metro and bus.'],
['Month view','<strong>Reliability is visible.</strong> On-time count and credits feed the north star, Daily Reliable Commuters.']]
